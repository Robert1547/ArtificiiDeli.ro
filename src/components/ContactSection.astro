---
import { siteConfig } from '../data/siteConfig';
---

<section class="contact-section" id="contact" aria-labelledby="contact-heading">
  <div class="container contact-grid">
    <!-- Left Column: Direct Action Channels & Checklist -->
    <div class="contact-direct-col">
      <span class="trajectory-marker">04 / Rezervare dată și ofertă</span>
      <h2 id="contact-heading" class="section-title">
        Verifică disponibilitatea pentru data evenimentului tău.
      </h2>
      <p class="contact-lead">
        Trimite-ne detaliile evenimentului pe WhatsApp sau e-mail, ori folosește configuratorul
        alăturat pentru a compune cererea de ofertă în câteva secunde.
      </p>

      <div class="direct-cards">
        <a
          href={siteConfig.contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="direct-channel-card channel-primary"
        >
          <span class="channel-kicker">Cel mai rapid răspuns</span>
          <strong class="channel-title">Scrie direct pe WhatsApp</strong>
          <span class="channel-meta">Deschide conversația cu mesaj precompletat</span>
        </a>

        <a href={`mailto:${siteConfig.contact.email}`} class="direct-channel-card">
          <span class="channel-kicker">Solicitare pe e-mail</span>
          <strong class="channel-title">{siteConfig.contact.email}</strong>
          <span class="channel-meta">Pentru oferte detaliate și evenimente corporate</span>
        </a>

        <div class="direct-channel-card channel-placeholder">
          <span class="channel-kicker">Contact telefonic &amp; Acoperire</span>
          <strong class="channel-title">{siteConfig.contact.phoneDisplay}</strong>
          <span class="channel-meta">{siteConfig.contact.serviceArea}</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Verified Quote Request Composer (Inline Validation + Real WhatsApp / Mailto Delivery) -->
    <div class="contact-form-col">
      <form class="quote-form" id="quote-request-form" novalidate>
        <div class="form-header">
          <h3 class="form-title">Compune cererea de ofertă</h3>
          <p class="form-subtitle">
            Completează reperele evenimentului și alege canalul prin care dorești să trimiți solicitarea.
          </p>
        </div>

        <div class="form-row-split">
          <div class="form-field">
            <label for="client-name">Numele tău <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="client-name"
              name="clientName"
              placeholder="Nume și prenume"
              required
              autocomplete="name"
              aria-describedby="error-client-name"
            />
            <p class="field-error" id="error-client-name" hidden></p>
          </div>

          <div class="form-field">
            <label for="client-phone">Telefon sau WhatsApp <span aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="client-phone"
              name="clientPhone"
              placeholder="Număr de telefon (07xx xxx xxx)"
              required
              autocomplete="tel"
              aria-describedby="error-client-phone"
            />
            <p class="field-error" id="error-client-phone" hidden></p>
          </div>
        </div>

        <div class="form-row-split">
          <div class="form-field">
            <label for="event-type">Tipul evenimentului <span aria-hidden="true">*</span></label>
            <select id="event-type" name="eventType" required aria-describedby="error-event-type">
              <option value="">Alege tipul evenimentului</option>
              <option value="Nuntă">Nuntă</option>
              <option value="Gender Reveal">Petrecere Gender Reveal</option>
              <option value="Botez">Botez</option>
              <option value="Eveniment Privat / Aniversare">Eveniment Privat / Aniversare</option>
              <option value="Eveniment Corporate / Public">Eveniment Corporate / Public</option>
            </select>
            <p class="field-error" id="error-event-type" hidden></p>
          </div>

          <div class="form-field">
            <label for="event-date">Data aproximativă a evenimentului</label>
            <input
              type="text"
              id="event-date"
              name="eventDate"
              placeholder="ZZ / LL / AAAA (sau luna estimată)"
            />
          </div>
        </div>

        <div class="form-field">
          <label for="event-location">Localitatea și locația (dacă este stabilită) <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="event-location"
            name="eventLocation"
            placeholder="Orașul și denumirea locației"
            required
            aria-describedby="error-event-location"
          />
          <p class="field-error" id="error-event-location" hidden></p>
        </div>

        <div class="form-field">
          <label for="event-details">Efecte dorite sau întrebări suplimentare</label>
          <textarea
            id="event-details"
            name="eventDetails"
            rows="3"
            placeholder="Menționează dacă dorești artificii de exterior, fum/artificii pentru Gender Reveal sau scântei reci pentru dansul mirilor..."
          ></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary form-submit-btn" data-delivery="whatsapp">
            Trimite cererea pe WhatsApp
          </button>
          <button type="submit" class="btn-secondary-outline" data-delivery="email">
            Trimite prin E-mail
          </button>
        </div>

        <!-- Explicit Feedback State (G-6, R-27) -->
        <div class="form-feedback" id="form-feedback" role="status" aria-live="polite" hidden>
          <p class="feedback-title" id="feedback-title"></p>
          <p class="feedback-body" id="feedback-body"></p>
          <button type="button" class="copy-summary-btn" id="copy-summary-btn">
            Copiază textul cererii în Clipboard
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { siteConfig } from '../data/siteConfig';

  const form = document.getElementById('quote-request-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('client-name') as HTMLInputElement | null;
  const phoneInput = document.getElementById('client-phone') as HTMLInputElement | null;
  const typeSelect = document.getElementById('event-type') as HTMLSelectElement | null;
  const dateInput = document.getElementById('event-date') as HTMLInputElement | null;
  const locationInput = document.getElementById('event-location') as HTMLInputElement | null;
  const detailsInput = document.getElementById('event-details') as HTMLTextAreaElement | null;

  const feedbackBox = document.getElementById('form-feedback');
  const feedbackTitle = document.getElementById('feedback-title');
  const feedbackBody = document.getElementById('feedback-body');
  const copyBtn = document.getElementById('copy-summary-btn');

  let lastGeneratedMessage = '';

  // Pre-fill service when clicking a service CTA link
  document.querySelectorAll<HTMLElement>('[data-service-select]').forEach((link) => {
    link.addEventListener('click', () => {
      const serviceName = link.dataset.serviceSelect;
      if (detailsInput && serviceName && !detailsInput.value.includes(serviceName)) {
        detailsInput.value = `Serviciu dorit: ${serviceName}. `;
      }
    });
  });

  function setFieldError(inputEl: HTMLElement | null, errorId: string, message: string | null) {
    const errorEl = document.getElementById(errorId);
    if (!inputEl || !errorEl) return;

    if (message) {
      inputEl.setAttribute('aria-invalid', 'true');
      errorEl.textContent = message;
      errorEl.removeAttribute('hidden');
    } else {
      inputEl.removeAttribute('aria-invalid');
      errorEl.textContent = '';
      errorEl.setAttribute('hidden', '');
    }
  }

  function validateField(field: HTMLElement): boolean {
    if (field === nameInput) {
      const val = nameInput.value.trim();
      if (val.length < 2) {
        setFieldError(nameInput, 'error-client-name', 'Te rugăm să introduci numele tău (minim 2 caractere).');
        return false;
      }
      setFieldError(nameInput, 'error-client-name', null);
      return true;
    }

    if (field === phoneInput) {
      const val = phoneInput.value.trim();
      if (val.length < 8) {
        setFieldError(phoneInput, 'error-client-phone', 'Introdu un număr de telefon valid pentru a-ți putea răspunde.');
        return false;
      }
      setFieldError(phoneInput, 'error-client-phone', null);
      return true;
    }

    if (field === typeSelect) {
      if (!typeSelect.value) {
        setFieldError(typeSelect, 'error-event-type', 'Selectează tipul evenimentului din listă.');
        return false;
      }
      setFieldError(typeSelect, 'error-event-type', null);
      return true;
    }

    if (field === locationInput) {
      const val = locationInput.value.trim();
      if (val.length < 2) {
        setFieldError(locationInput, 'error-event-location', 'Menționează localitatea sau locația evenimentului.');
        return false;
      }
      setFieldError(locationInput, 'error-event-location', null);
      return true;
    }

    return true;
  }

  [nameInput, phoneInput, typeSelect, locationInput].forEach((el) => {
    el?.addEventListener('blur', () => validateField(el));
    el?.addEventListener('input', () => {
      if (el.getAttribute('aria-invalid') === 'true') {
        validateField(el);
      }
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    const deliveryChannel = submitter?.dataset.delivery || 'whatsapp';

    const validName = nameInput ? validateField(nameInput) : false;
    const validPhone = phoneInput ? validateField(phoneInput) : false;
    const validType = typeSelect ? validateField(typeSelect) : false;
    const validLocation = locationInput ? validateField(locationInput) : false;

    if (!validName || !validPhone || !validType || !validLocation) {
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      firstInvalid?.focus();
      return;
    }

    const lines = [
      `Bună ziua! Doresc o ofertă de la ${siteConfig.brandName}:`,
      `• Nume: ${nameInput!.value.trim()}`,
      `• Telefon: ${phoneInput!.value.trim()}`,
      `• Eveniment: ${typeSelect!.value}`,
      `• Data: ${dateInput?.value.trim() || 'Neconfirmată încă'}`,
      `• Locație: ${locationInput!.value.trim()}`,
    ];

    if (detailsInput?.value.trim()) {
      lines.push(`• Detalii efecte: ${detailsInput.value.trim()}`);
    }

    lastGeneratedMessage = lines.join('\n');

    if (feedbackBox && feedbackTitle && feedbackBody) {
      feedbackBox.removeAttribute('hidden');
      feedbackTitle.textContent = 'Cererea ta a fost pregătită pentru trimitere.';
      feedbackBody.textContent =
        deliveryChannel === 'email'
          ? 'Am deschis aplicația de e-mail cu toate detaliile completate. Poți de asemenea să copiezi textul mai jos.'
          : 'Am deschis fereastra WhatsApp cu rezumatul evenimentului tău. Poți de asemenea să copiezi textul mai jos.';
    }

    if (deliveryChannel === 'email') {
      const subject = encodeURIComponent(`Cerere ofertă eveniment: ${typeSelect!.value} (${locationInput!.value.trim()})`);
      const body = encodeURIComponent(lastGeneratedMessage);
      window.location.href = `mailto:${siteConfig.contact.email}?subject=${subject}&body=${body}`;
    } else {
      const encoded = encodeURIComponent(lastGeneratedMessage);
      window.open(`https://wa.me/?text=${encoded}`, '_blank', 'noopener,noreferrer');
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (!lastGeneratedMessage) return;
    try {
      await navigator.clipboard.writeText(lastGeneratedMessage);
      copyBtn.textContent = 'Textul cererii a fost copiat!';
      window.setTimeout(() => {
        copyBtn.textContent = 'Copiază textul cererii în Clipboard';
      }, 2500);
    } catch {
      copyBtn.textContent = 'Copierea automată nu a fost permisă de browser';
    }
  });
</script>

<style>
  .contact-section {
    padding-block: var(--space-24);
    background:
      radial-gradient(circle at 18% 24%, rgba(8, 124, 255, 0.12) 0%, transparent 48%),
      var(--bg-navy);
    border-bottom: 1px solid var(--border-subtle);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact-direct-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .direct-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .direct-channel-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
    background-color: var(--bg-midnight);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }

  a.direct-channel-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
  }

  .channel-primary {
    border-color: var(--border-interactive);
    background: linear-gradient(135deg, rgba(8, 124, 255, 0.14) 0%, rgba(7, 20, 38, 0.96) 100%);
  }

  .channel-placeholder {
    border-style: dashed;
  }

  .channel-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
  }

  .channel-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .channel-meta {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* Form Styling */
  .quote-form {
    padding: var(--space-6);
    background-color: var(--bg-midnight);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    box-shadow: var(--shadow-elevated);
  }

  .form-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .form-subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .form-row-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-field label span {
    color: var(--accent-cyan);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    min-height: 46px;
    padding: 0.65rem 0.9rem;
    background-color: var(--bg-navy);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: border-color var(--duration-fast) var(--ease-out-expo);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-muted);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--accent-cyan);
  }

  .form-field [aria-invalid='true'] {
    border-color: var(--accent-red);
  }

  .field-error {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-red);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .form-submit-btn {
    flex: 1 1 220px;
  }

  .btn-secondary-outline {
    flex: 1 1 160px;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    background-color: var(--bg-navy);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }

  .btn-secondary-outline:hover {
    background-color: var(--bg-navy-elevated);
    border-color: var(--accent-cyan);
  }

  .form-feedback {
    padding: var(--space-4);
    background-color: rgba(57, 217, 255, 0.1);
    border: 1px solid var(--accent-cyan);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feedback-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
  }

  .feedback-body {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .copy-summary-btn {
    align-self: flex-start;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    background-color: var(--bg-navy);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-xs);
    color: var(--accent-cyan);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .form-row-split {
      grid-template-columns: 1fr 1fr;
    }

    .quote-form {
      padding: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }
</style>
