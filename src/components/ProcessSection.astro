---
import { siteConfig } from '../data/siteConfig';
---

<section class="process-section" id="proces" aria-labelledby="process-heading">
  <div class="container process-grid">
    <!-- Left Column: Sticky Architectural Intro -->
    <div class="process-lead-col">
      <span class="trajectory-marker">03 / Siguranță și organizare</span>
      <h2 id="process-heading" class="section-title">
        Fiecare lansare începe cu evaluarea terenului și sincronizarea la secundă.
      </h2>
      <p class="process-intro">
        Un spectacol reușit înseamnă zero improvizații în seara evenimentului. Ne ocupăm de
        verificarea spațiului, distanțele de siguranță și coordonarea cu echipa foto-video,
        astfel încât mirii și invitații doar să privească cerul.
      </p>

      <div class="process-callout">
        <strong class="callout-title">Transparență și autorizare</strong>
        <p>
          Toate detaliile legate de perimetrul necesar și tipul efectelor permise în interiorul
          sau exteriorul locației sunt stabilite înainte de eveniment.
        </p>
      </div>
    </div>

    <!-- Right Column: 4-Stage Trajectory Ledger (Not a 3-card icon grid) -->
    <ol class="process-ledger">
      {
        siteConfig.processSteps.map((step) => (
          <li class="ledger-row">
            <div class="ledger-step-marker" aria-hidden="true">
              <span class="ledger-number">{step.stepNumber}</span>
              <span class="ledger-line"></span>
            </div>
            <div class="ledger-body">
              <h3 class="ledger-title">{step.title}</h3>
              <p class="ledger-desc">{step.description}</p>
              <p class="ledger-tech-note">{step.technicalNote}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-section {
    padding-block: var(--space-24);
    background-color: var(--bg-midnight);
    border-bottom: 1px solid var(--border-subtle);
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .process-lead-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .process-intro {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 48ch;
  }

  .process-callout {
    margin-top: var(--space-4);
    padding: var(--space-6);
    background-color: var(--bg-navy);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-sm);
  }

  .callout-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--accent-cyan);
    margin-bottom: var(--space-2);
  }

  .process-callout p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .process-ledger {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
    background-color: var(--bg-navy);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .ledger-step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .ledger-number {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--accent-cyan);
  }

  .ledger-line {
    flex: 1;
    width: 2px;
    min-height: 36px;
    background: linear-gradient(180deg, var(--accent-cyan) 0%, var(--accent-blue) 60%, transparent 100%);
  }

  .ledger-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ledger-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .ledger-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .ledger-tech-note {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-cyan);
    padding-top: var(--space-2);
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }

    .process-lead-col {
      position: sticky;
      top: calc(var(--header-height) + var(--space-8));
    }
  }
</style>
