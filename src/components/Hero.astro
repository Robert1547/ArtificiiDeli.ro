---
import { siteConfig } from '../data/siteConfig';
---

<section class="hero-section" id="hero" aria-labelledby="hero-heading">
  <!-- Interactive HTML Canvas 2D layer -->
  <canvas
    id="hero-fireworks-canvas"
    class="hero-canvas"
    aria-hidden="true"
  ></canvas>

  <div class="container hero-grid">
    <!-- Asymmetric Left Column: Narrative & Primary Action (No D-4 left border box; sits directly on protected nocturnal scrim) -->
    <div class="hero-copy-col">
      <div class="hero-eyebrow-row">
        <span class="trajectory-marker">
          Spectacole pirotehnice &amp; efecte speciale
        </span>
      </div>

      <h1 id="hero-heading" class="hero-headline">
        <span class="headline-kicker">Nopți electrice.</span>
        Spectacole de artificii și efecte vizuale pentru evenimentul tău.
      </h1>

      <p class="hero-lead">
        Proiectăm și operăm coregrafii pirotehnice de exterior, momente cromatice pentru
        <strong>Gender Reveal</strong> și fântâni de scântei reci pentru nunți și petreceri private.
        Fiecare declanșare este calculată pentru arhitectura locației și momentul culminant al serii.
      </p>

      <div class="hero-cta-group">
        <a href="#contact" class="btn-primary hero-primary-btn">
          Solicită o ofertă pentru eveniment
        </a>
        <a href="#servicii" class="btn-secondary-link">
          Explorează serviciile și galeria foto-video
        </a>
      </div>

      <div class="hero-canvas-controls">
        <button
          type="button"
          id="hero-launch-btn"
          class="canvas-trigger-btn"
          aria-label="Lansează o salvă de artificii pe cerul din fundal"
        >
          <span class="trigger-spark-dot" aria-hidden="true"></span>
          <span id="hero-launch-label">Lansează o salvă pe cer</span>
        </button>
        <span class="canvas-hint" id="hero-canvas-hint">
          Sau atinge cerul nopții pentru o explozie interactivă
        </span>
      </div>

      <dl class="hero-specs" aria-label="Repere principale">
        <div class="spec-item">
          <dt>Evenimente</dt>
          <dd>Nunți, Gender Reveal, botezuri și evenimente private</dd>
        </div>
        <div class="spec-item">
          <dt>Acoperire</dt>
          <dd>{siteConfig.contact.serviceArea}</dd>
        </div>
      </dl>
    </div>

    <!-- Asymmetric Right Column: Editorial Diptych Composition (16:9 Exterior + 9:16 Gender Reveal Offset) -->
    <div class="hero-visual-col">
      <div class="hero-diptych">
        <!-- Main Frame: Nocturnal High-Altitude Burst -->
        <figure class="hero-showcase-frame">
          <div
            class="showcase-media-placeholder"
            role="img"
            aria-label="Cadru vizual demonstrativ cu artificii albastre și cyan deasupra unei locații de eveniment"
          >
            <svg
              viewBox="0 0 720 520"
              class="showcase-svg"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <radialGradient id="skyGlowBlue" cx="62%" cy="36%" r="52%">
                  <stop offset="0%" stop-color="#39D9FF" stop-opacity="0.42" />
                  <stop offset="42%" stop-color="#087CFF" stop-opacity="0.22" />
                  <stop offset="100%" stop-color="#071426" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="skyGlowSecondary" cx="28%" cy="48%" r="38%">
                  <stop offset="0%" stop-color="#EC42D7" stop-opacity="0.34" />
                  <stop offset="55%" stop-color="#087CFF" stop-opacity="0.12" />
                  <stop offset="100%" stop-color="#071426" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="plumeMain" x1="0" y1="1" x2="0" y2="0">
                  <stop offset="0%" stop-color="#071426" stop-opacity="0" />
                  <stop offset="55%" stop-color="#087CFF" stop-opacity="0.75" />
                  <stop offset="100%" stop-color="#F5FAFF" stop-opacity="1" />
                </linearGradient>
              </defs>

              <rect width="720" height="520" fill="#061120" />
              <rect width="720" height="520" fill="url(#skyGlowBlue)" />
              <rect width="720" height="520" fill="url(#skyGlowSecondary)" />

              <!-- Launch plumes rising from the venue horizon -->
              <path d="M438 445 Q442 315 446 188" stroke="url(#plumeMain)" stroke-width="2.5" fill="none" />
              <path d="M210 445 Q204 345 198 248" stroke="url(#plumeMain)" stroke-width="1.8" fill="none" opacity="0.8" />
              <path d="M555 445 Q562 350 568 265" stroke="url(#plumeMain)" stroke-width="1.5" fill="none" opacity="0.65" />

              <!-- Primary Chrysanthemum Burst at (446, 188) -->
              <g transform="translate(446, 188)">
                <circle r="16" fill="#39D9FF" opacity="0.25" />
                <circle r="5" fill="#F5FAFF" />
                <g stroke="#F5FAFF" stroke-linecap="round" stroke-width="2.2" opacity="0.95">
                  <line x1="0" y1="-12" x2="0" y2="-126" />
                  <line x1="0" y1="12" x2="0" y2="126" />
                  <line x1="-12" y1="0" x2="-126" y2="0" />
                  <line x1="12" y1="0" x2="126" y2="0" />
                  <line x1="9" y1="-9" x2="89" y2="-89" />
                  <line x1="-9" y1="-9" x2="-89" y2="-89" />
                  <line x1="9" y1="9" x2="89" y2="89" />
                  <line x1="-9" y1="9" x2="-89" y2="89" />
                </g>
                <g stroke="#39D9FF" stroke-linecap="round" stroke-width="1.8" opacity="0.88">
                  <line x1="5" y1="-11" x2="48" y2="-116" />
                  <line x1="-5" y1="-11" x2="-48" y2="-116" />
                  <line x1="11" y1="-5" x2="116" y2="-48" />
                  <line x1="11" y1="5" x2="116" y2="48" />
                  <line x1="5" y1="11" x2="48" y2="116" />
                  <line x1="-5" y1="11" x2="-48" y2="116" />
                  <line x1="-11" y1="5" x2="-116" y2="48" />
                  <line x1="-11" y1="-5" x2="-116" y2="-48" />
                </g>
                <g stroke="#087CFF" stroke-linecap="round" stroke-width="1.4" stroke-dasharray="3 8" opacity="0.85">
                  <circle r="68" fill="none" />
                  <circle r="104" fill="none" />
                  <circle r="134" fill="none" />
                </g>
                <circle cx="0" cy="-134" r="3" fill="#F5FAFF" />
                <circle cx="95" cy="-95" r="3" fill="#39D9FF" />
                <circle cx="134" cy="0" r="3" fill="#F5FAFF" />
                <circle cx="95" cy="95" r="2.5" fill="#39D9FF" />
                <circle cx="0" cy="134" r="3" fill="#F5FAFF" />
                <circle cx="-95" cy="95" r="2.5" fill="#FF405B" />
                <circle cx="-134" cy="0" r="3" fill="#39D9FF" />
                <circle cx="-95" cy="-95" r="3" fill="#F5FAFF" />
              </g>

              <!-- Secondary Magenta/Cyan Burst at (198, 248) -->
              <g transform="translate(198, 248)">
                <circle r="4" fill="#F5FAFF" />
                <g stroke="#EC42D7" stroke-linecap="round" stroke-width="1.9" opacity="0.9">
                  <line x1="0" y1="-10" x2="0" y2="-78" />
                  <line x1="0" y1="10" x2="0" y2="78" />
                  <line x1="-10" y1="0" x2="-78" y2="0" />
                  <line x1="10" y1="0" x2="78" y2="0" />
                  <line x1="7" y1="-7" x2="55" y2="-55" />
                  <line x1="-7" y1="-7" x2="-55" y2="-55" />
                  <line x1="7" y1="7" x2="55" y2="55" />
                  <line x1="-7" y1="7" x2="-55" y2="55" />
                </g>
                <circle cx="0" cy="-84" r="2.5" fill="#F5FAFF" />
                <circle cx="59" cy="-59" r="2.5" fill="#39D9FF" />
                <circle cx="-59" cy="-59" r="2.5" fill="#EC42D7" />
                <circle cx="59" cy="59" r="2.5" fill="#F5FAFF" />
                <circle cx="-59" cy="59" r="2.5" fill="#39D9FF" />
              </g>

              <!-- Distant Accent Burst at (568, 265) -->
              <g transform="translate(568, 265)" opacity="0.8">
                <circle r="3" fill="#F5FAFF" />
                <g stroke="#39D9FF" stroke-linecap="round" stroke-width="1.5">
                  <line x1="0" y1="-8" x2="0" y2="-52" />
                  <line x1="0" y1="8" x2="0" y2="52" />
                  <line x1="-8" y1="0" x2="-52" y2="0" />
                  <line x1="8" y1="0" x2="52" y2="0" />
                  <line x1="6" y1="-6" x2="36" y2="-36" />
                  <line x1="-6" y1="-6" x2="-36" y2="-36" />
                  <line x1="6" y1="6" x2="36" y2="36" />
                  <line x1="-6" y1="6" x2="-36" y2="36" />
                </g>
              </g>

              <!-- Horizon & Lake Reflection -->
              <path d="M0 442 L115 436 L175 424 L260 438 L410 432 L540 420 L635 434 L720 430 L720 520 L0 520 Z" fill="#040B16" />
              <line x1="0" y1="443" x2="720" y2="443" stroke="#122A4A" stroke-width="1" />
              <g opacity="0.4">
                <line x1="395" y1="460" x2="495" y2="460" stroke="#39D9FF" stroke-width="2" />
                <line x1="412" y1="474" x2="478" y2="474" stroke="#087CFF" stroke-width="1.5" />
                <line x1="168" y1="466" x2="228" y2="466" stroke="#EC42D7" stroke-width="1.5" />
              </g>
            </svg>

            <div class="showcase-top-bar">
              <span class="placeholder-badge">
                [CADRU DEMONSTRATIV: PREGĂTIT PENTRU ARHIVA FOTO/VIDEO CLIENT]
              </span>
            </div>
          </div>

          <figcaption class="showcase-caption-bar">
            <div class="caption-meta">
              <span class="caption-index">01 / SPECTACOL EXTERIOR &amp; GENDER REVEAL</span>
              <p class="caption-title">Coregrafii pe cerul nopții, fum colorat și fântâni de scântei reci</p>
            </div>
            <div class="caption-swatches" aria-label="Paletă cromatică de lansare">
              <span class="swatch swatch-blue" title="Albastru electric"></span>
              <span class="swatch swatch-cyan" title="Cyan luminos"></span>
              <span class="swatch swatch-magenta" title="Magenta Gender Reveal"></span>
            </div>
          </figcaption>
        </figure>

        <!-- Secondary Offset Card: Service Quick-Preview -->
        <div class="hero-offset-tag" aria-label="Categorii principale de efecte">
          <div class="offset-tag-row">
            <span class="tag-dot tag-dot-cyan" aria-hidden="true"></span>
            <span>Artificii exterior &amp; baterii profesionale</span>
          </div>
          <div class="offset-tag-row">
            <span class="tag-dot tag-dot-magenta" aria-hidden="true"></span>
            <span>Gender Reveal (fum de zi &amp; artificii roz/cyan)</span>
          </div>
          <div class="offset-tag-row">
            <span class="tag-dot tag-dot-white" aria-hidden="true"></span>
            <span>Scântei reci (Cold Sparks) pentru dansul mirilor</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroFireworks } from '../scripts/fireworks-canvas';

  const canvas = document.getElementById('hero-fireworks-canvas') as HTMLCanvasElement | null;
  const heroSection = document.getElementById('hero');
  const launchBtn = document.getElementById('hero-launch-btn') as HTMLButtonElement | null;
  const hintEl = document.getElementById('hero-canvas-hint');

  if (canvas && heroSection) {
    initHeroFireworks(canvas, heroSection, launchBtn);

    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncReducedMotionMessage = (reduced: boolean) => {
      if (hintEl) {
        hintEl.textContent = reduced
          ? 'Animațiile sunt oprite automat conform preferinței tale de sistem (mișcare redusă).'
          : 'Sau atinge cerul nopții pentru o explozie interactivă';
      }
    };
    syncReducedMotionMessage(mq.matches);
    mq.addEventListener('change', (e) => syncReducedMotionMessage(e.matches));
  }
</script>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-8) var(--space-12);
    background:
      radial-gradient(circle at 74% 32%, rgba(8, 124, 255, 0.14) 0%, transparent 50%),
      radial-gradient(circle at 20% 45%, rgba(7, 20, 38, 0.94) 0%, rgba(7, 20, 38, 0.65) 55%, transparent 100%),
      var(--bg-midnight);
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-copy-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    max-width: 18ch;
    text-shadow: 0 2px 20px rgba(7, 20, 38, 0.95), 0 0 8px rgba(7, 20, 38, 0.9);
  }

  .headline-kicker {
    display: block;
    color: var(--accent-cyan);
    margin-bottom: var(--space-1);
  }

  .hero-lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    max-width: 54ch;
    line-height: 1.62;
    text-shadow: 0 1px 12px rgba(7, 20, 38, 0.95);
  }

  .hero-lead strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-top: var(--space-2);
  }

  .hero-canvas-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }

  .canvas-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    background-color: rgba(12, 30, 54, 0.9);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo);
  }

  .canvas-trigger-btn:hover {
    border-color: var(--accent-cyan);
    background-color: var(--bg-navy-elevated);
  }

  .canvas-trigger-btn[aria-disabled='true'] {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .trigger-spark-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-magenta);
    box-shadow: 0 0 8px var(--accent-magenta);
  }

  .canvas-hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .hero-specs {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-top: var(--space-4);
    margin-top: var(--space-1);
    border-top: 1px solid var(--border-subtle);
  }

  .spec-item dt {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-cyan);
    margin-bottom: 2px;
  }

  .spec-item dd {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .hero-visual-col {
    position: relative;
  }

  .hero-diptych {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-showcase-frame {
    background-color: var(--bg-navy);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
  }

  .showcase-media-placeholder {
    position: relative;
    aspect-ratio: 16 / 11.5;
    background-color: var(--bg-midnight);
    overflow: hidden;
  }

  .showcase-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-top-bar {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
    display: flex;
    justify-content: flex-start;
  }

  .showcase-caption-bar {
    padding: var(--space-3) var(--space-4);
    background-color: var(--bg-navy);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .caption-index {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-cyan);
    margin-bottom: 2px;
  }

  .caption-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .caption-swatches {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-xs);
  }

  .swatch-blue {
    background-color: var(--accent-blue);
  }

  .swatch-cyan {
    background-color: var(--accent-cyan);
  }

  .swatch-magenta {
    background-color: var(--accent-magenta);
  }

  .hero-offset-tag {
    background-color: rgba(12, 30, 54, 0.92);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .offset-tag-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .tag-dot-cyan {
    background-color: var(--accent-cyan);
  }

  .tag-dot-magenta {
    background-color: var(--accent-magenta);
  }

  .tag-dot-white {
    background-color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .hero-specs {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 6.5fr 5.5fr;
      gap: var(--space-12);
    }
  }
</style>
