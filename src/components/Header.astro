---
import { siteConfig } from '../data/siteConfig';
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="#top" class="brand-link" aria-label={`${siteConfig.brandName}, înapoi sus`}>
      <span class="brand-mark" aria-hidden="true">
        <span class="brand-spark"></span>
      </span>
      <span class="brand-text">
        <span class="brand-name">{siteConfig.brandName}</span><span class="brand-domain">.ro</span>
      </span>
      <span class="brand-placeholder-tag" title="Logo-ul grafic va fi actualizat la confirmarea clientului">
        [LOGOTIP]
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigație principală">
      <ul class="nav-list">
        {
          siteConfig.navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="#contact" class="header-cta">
        Solicită ofertă
      </a>

      <button
        type="button"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        id="mobile-menu-btn"
      >
        <span class="menu-toggle-label">Meniu</span>
        <span class="menu-toggle-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-nav-drawer" hidden>
    <div class="container mobile-drawer-inner">
      <nav aria-label="Meniu mobil">
        <ul class="mobile-nav-list">
          {
            siteConfig.navItems.map((item, idx) => (
              <li>
                <a href={item.href} class="mobile-nav-link">
                  <span class="mobile-nav-index">0{idx + 1}</span>
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mobile-drawer-footer">
        <a href="#contact" class="btn-primary mobile-drawer-cta">
          Solicită o ofertă pentru eveniment
        </a>
        <p class="mobile-drawer-note">
          Răspundem rapid pe WhatsApp sau telefonic pentru verificarea disponibilității datei.
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-nav-drawer');

  if (menuBtn && drawer) {
    const toggleLabel = menuBtn.querySelector('.menu-toggle-label');

    const setMenuState = (isOpen: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        drawer.removeAttribute('hidden');
        if (toggleLabel) toggleLabel.textContent = 'Închide';
      } else {
        drawer.setAttribute('hidden', '');
        if (toggleLabel) toggleLabel.textContent = 'Meniu';
      }
    };

    menuBtn.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      setMenuState(!expanded);
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setMenuState(false);
        menuBtn.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(7, 20, 38, 0.94);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-block: var(--space-1);
    white-space: nowrap;
  }

  .brand-mark {
    position: relative;
    width: 12px;
    height: 28px;
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-mark::after {
    content: '';
    position: absolute;
    bottom: 0;
    top: 7px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-cyan) 0%, var(--accent-blue) 68%, transparent 100%);
  }

  .brand-spark {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(57, 217, 255, 0.85);
  }

  .brand-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .brand-domain {
    color: var(--accent-cyan);
    font-weight: 700;
  }

  .brand-placeholder-tag {
    display: none;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px dashed var(--border-structural);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-xs);
  }

  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    position: relative;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: 8px;
    height: 2px;
    background-color: var(--accent-cyan);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header-cta {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    background-color: var(--accent-blue-ink);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }

  .header-cta:hover {
    background-color: var(--accent-cyan);
    color: var(--text-on-bright);
    border-color: var(--accent-cyan);
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.85rem;
    background-color: var(--bg-navy);
    border: 1px solid var(--border-structural);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .menu-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    width: 18px;
  }

  .menu-toggle-bars span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--accent-cyan);
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .mobile-menu-toggle[aria-expanded='true'] .menu-toggle-bars span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded='true'] .menu-toggle-bars span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-drawer {
    background-color: var(--bg-navy);
    border-bottom: 1px solid var(--border-interactive);
  }

  .mobile-drawer-inner {
    padding-block: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 52px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .mobile-nav-index {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-drawer-cta {
    width: 100%;
  }

  .mobile-drawer-note {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  @media (min-width: 560px) {
    .brand-placeholder-tag {
      display: inline-block;
    }
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .mobile-drawer {
      display: none !important;
    }
  }
</style>
